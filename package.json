{
  "name": "jobr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "vitest run tests/unit tests/integration tests/security --coverage",
    "test:db": "bash scripts/run-pgtap-local.sh",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:live": "vitest run tests/live",
    "test:db:supabase": "supabase db reset --local && supabase test db",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "ipaddr.js": "^2.2.0",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.3.1",
    "undici": "^6.21.3",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.11",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.30",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "4.0.18",
    "wrangler": "^4.151.0"
  }
}
