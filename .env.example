# Public Supabase configuration: set for the target environment before building.
# NEXT_PUBLIC_* values are included in browser assets; never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=
OPENAI_API_KEY=
XAI_API_KEY=
